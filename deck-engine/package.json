{
  "name": "@entity-builders/deck-engine",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:digital": "npx tsx src/scripts/check-digital.ts",
    "test:music-bingo": "npx tsx src/scripts/check-music-bingo.ts",
    "test:music-bingo-pricing": "npx tsx src/scripts/check-music-bingo-pricing.ts",
    "test:music-bingo-pack": "npx tsx src/scripts/check-music-bingo-pack.ts",
    "check-products": "npx tsx src/scripts/check-products.ts",
    "sync": "npx tsx src/scripts/sync-decks.ts",
    "generate": "npx tsx src/scripts/create-edition.ts && npm run sync",
    "art": "npx tsx src/scripts/generate-art.ts",
    "frame": "npx tsx src/scripts/generate-frame.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
