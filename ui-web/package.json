{
  "name": "@eb-packages/ui-web",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens": {
      "types": "./src/tokens.ts",
      "import": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./gallery": {
      "types": "./src/gallery.tsx",
      "import": "./src/gallery.tsx",
      "default": "./src/gallery.tsx"
    },
    "./elements": {
      "types": "./src/elements.ts",
      "import": "./src/elements.ts",
      "default": "./src/elements.ts"
    }
  },
  "sideEffects": [
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc",
    "gallery:dev": "vite --host 0.0.0.0 --port 5180",
    "gallery:build": "vite build"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.3.4"
  }
}
