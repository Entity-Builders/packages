{
  "name": "entity-builders-packages",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "*"
  ],
  "scripts": {
    "build:all": "yarn workspaces foreach --all --topological -p run build",
    "publish:all": "yarn workspaces foreach --all --topological --no-private npm publish --tolerate-republish"
  }
}
